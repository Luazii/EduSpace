{
  "name": "learniverse-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.15",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "next": "~15.5.14",
    "tailwindcss": "^3.4.17",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
